# Настройки запускателя OpenCode Web (GONBA) на ЭТОМ компьютере.
#
# Как пользоваться: скопируй этот файл рядом со скриптом под именем `opencode-web.conf`
# и поправь значения. Файла нет — запускатель работает на умолчаниях: GONBA / 14974 / 49374.
# Кавычки не нужны; строка, начинающаяся с `#`, — комментарий.

# Куда идти по SSH: алиас из ~/.ssh/config этого компьютера либо user@адрес.
# Так адрес бокса не лежит ни в скрипте, ни в этом шаблоне — только на конкретной машине.
SSH_TARGET=GONBA

# Приватный ключ для этого подключения (пусто — ключи по умолчанию / ssh-agent).
# Путь лучше писать с прямыми слэшами: C:/Users/<ты>/.ssh/имя_ключа
IDENTITY_FILE=

# Локальный порт туннеля на этом компьютере (должен быть свободен).
LOCAL_PORT=14974

# Порт, на котором сервер OpenCode слушает на боксе. Менять не нужно.
REMOTE_PORT=49374
