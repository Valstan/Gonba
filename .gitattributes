# Шелл-скрипты обязаны оставаться LF: CRLF ломает bash (ошибки $'\r' на Linux и
# при запуске git_sync_check.sh как SessionStart-хука на Windows через Git Bash).
# Нормализуем на всех машинах.
*.sh text eol=lf

# Юниты systemd монтируются копированием с бокса (`sudo cp`): CRLF внутри значения
# директивы — тот же класс, что CRLF в шелл-скрипте. Держим LF на всех машинах.
*.service text eol=lf
*.timer text eol=lf

# Windows-скрипты: CRLF привычен для PowerShell, файлы несут кириллицу и UTF-8 BOM
# (PowerShell 5.1 читает UTF-8 без BOM как CP1251 и падает на кириллице).
*.ps1 text eol=crlf

# Обёртка для двойного клика: cmd.exe надёжнее с CRLF.
*.cmd text eol=crlf

# Конфиг запускателя OpenCode Web читают ОБЕ версии (PowerShell и bash): CRLF в конце
# строки попал бы в значение (ssh-цель, порты) и сломал подключение. Держим LF.
*.conf text eol=lf
# Шаблон конфига (то же правило).
*.conf.example text eol=lf
