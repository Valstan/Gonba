# PostgreSQL connection
# Локально (Windows + системный Postgres 16 от MSI-инсталлятора):
#   user/password по умолчанию = postgres/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gonba
# Через docker compose (web/docker-compose.yml): user/password = postgres/postgres
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/gonba

# Payload auth secret (encrypt JWT tokens)
PAYLOAD_SECRET=generate_a_random_secret_here

# Public server URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# For production set both to your public domain, e.g.:
# NEXT_PUBLIC_SERVER_URL=https://yourdomain.ru
# PAYLOAD_PUBLIC_SERVER_URL=https://yourdomain.ru

# Secret used to authenticate cron jobs
CRON_SECRET=generate_a_cron_secret_here

# Secret used to validate preview requests
PREVIEW_SECRET=generate_a_preview_secret_here

# Yandex Disk integration
YANDEX_DISK_TOKEN=your_yandex_oauth_token
YANDEX_DISK_BASE_PATH=/gonba
YANDEX_DISK_MEDIA_PATH=/gonba/media

# Media on-disk cache for the /api/media/file/[id] proxy (lazy TTL cache of
# Yandex-backed files). Keep it OUTSIDE public/ so deploy builds don't reset
# atime — the demand signal the daily cleaner (gonba-media-cache.timer) rotates
# on a 30-day TTL. Prod: /var/lib/gonba/media-cache. Dev default: public/media-cache.
# MEDIA_CACHE_DIR=/var/lib/gonba/media-cache

# VK import configuration
VK_GROUP_POST_LIMIT=50
VK_IMPORT_DELAY_MS=700
VK_IMPORT_QUEUE_ONLY=1
VK_IMPORT_AUTO_PUBLISH=0
VK_IMPORT_DRY_RUN=0

# VK auto-sync reads VK only through the SARAFAN gateway. Raw VK_TOKEN_* values
# are intentionally unsupported: revoking the gateway key must revoke access.
SARAFAN_GATEWAY_KEY=ask_the_sarafan_owner_for_GONBA_key
# SARAFAN_GATEWAY_URL=https://<хост шлюза SARAFAN>   # чужая инфраструктура — адрес не публикуем

# Optional VK post classifier. The key is a runtime secret; production should
# receive it through KARMAN Vault, never through Git or a NEXT_PUBLIC variable.
# OPENAI_API_KEY=ask_for_openai_api_key
# VK_CLASSIFIER_MODEL=gpt-5-mini
# VK_CLASSIFIER_TIMEOUT_MS=10000

# Vault recovery bootstrap (scenario A). On production these belong in the
# separate root-owned /etc/gonba/secrets-token.env, not gonba.env and not Git.
# SECRETS_TOKEN=room_bootstrap_token
# SECRETS_VAULT_URL=https://<хост прод-бокса>/api/secrets   # адрес не публикуем

# Веб-аналитика (runtime env бокса, НЕ NEXT_PUBLIC — читается /api/analytics-config
# на каждый запрос → включение/выключение без пересборки: env + restart gonba).
# Пусто/отсутствует = выключено полностью (ни баннера, ни счётчика, ни информера).
# Единственный счётчик экосистемы — Яндекс.Метрика (D-025, LiveInternet отменён).
# YM_COUNTER_ID=12345678   # номер счётчика Яндекс.Метрики

# HTTP-жизненный цикл (G234). Значения по умолчанию заданы в коде/юните, здесь —
# только если нужно переопределить на конкретном боксе.
# KEEP_ALIVE_TIMEOUT=65000   # должен быть ДЛИННЕЕ keep-alive пула прокси
# SHUTDOWN_DRAIN_MS=15000    # сколько ждать активные запросы на SIGTERM
