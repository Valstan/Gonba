[Unit]
Description=OpenCode Web (anonymous pool: free models, no account) — v2 API + web UI on loopback
Documentation=https://opencode.ai/v2/docs/cli/web/
# Egress — только через ВПН (D-152): движок подтягивает свой ВПН-клиент сам.
After=network-online.target neural-vpn.service
Wants=network-online.target neural-vpn.service
# Цикл перезапусков не должен превратиться в молотилку: 5 падений за 5 минут — стоп.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=valstan
Group=valstan
WorkingDirectory=/home/valstan/repo/Gonba
EnvironmentFile=/home/valstan/.config/opencode-web/anon.env
Environment=HOME=/home/valstan
# Отдельный каталог данных = отдельный пул лимитов (см. docs/plans/opencode-web-on-prod.md).
Environment=XDG_DATA_HOME=/home/valstan/.local/share/opencode-anon
# --- Egress через ВПН (D-152, письмо Мозга 2026-10-22) ---
# Free-модели квотируются на СЕТЬ: без ВПН улей ест квоту прод-IP, а на общем белом
# адресе суммарную частоту не видит никто. Bun уважает HTTPS_PROXY (socks — нет),
# поэтому юнит ходит в HTTP-инбаунд xray (:8118). nft-redirect по uid здесь нельзя:
# движок и сайт под одним пользователем valstan, redirect увёл бы в туннель весь прод.
# Fail-closed: нет xray — нет выхода в модели; тихого прямого выхода не бывает.
Environment=HTTPS_PROXY=http://127.0.0.1:8118
Environment=HTTP_PROXY=http://127.0.0.1:8118
Environment=NO_PROXY=localhost,127.0.0.1,::1
ExecStart=/usr/local/bin/opencode serve --hostname 127.0.0.1 --port 49374
Restart=on-failure
RestartSec=5
# Замер 18.10: opencode завершается кодом 130 (SIGINT-стиль) по SIGTERM, и systemd
# писал такую остановку как сбой (`Active: failed`) — а это штатный выключатель
# ярлыка «выключить». Объявляем код успешным: `systemctl stop` даёт `inactive`,
# а настоящие падения (SIGKILL, 137) по-прежнему считаются сбоем и триггерят
# Restart=on-failure, так что страховка от крашей не ослаблена.
SuccessExitStatus=130
# Задохнувшийся сервер не отдаёт SIGTERM сразу (18.10.2026 вечер: 548 МБ при MemoryHigh=500M,
# pressure 100 %, HTTP молчит, но юнит «активен»). По умолчанию systemd ждёт такого 90 с —
# ровно столько же ждала сессия ярлыка «выключить», и гонка заканчивалась вничью: владелец
# видел «бокс не ответил» на успешной остановке. 30 с хватает: живому серверу нужно ~1 с,
# а зависший всё равно не отвечает.
TimeoutStopSec=30

# --- Добрый сосед: 1 ядро и ~780 МБ свободной ОЗУ делятся с 6 сайтами и Postgres ---
# Замер 17.10: холостой сервер держит ~370 МБ (MemoryCurrent 379 МБ при простое).
# Потолок намеренно ниже «щедрого»: пусть агент получает kill, а не уводит бокс в swap.
Nice=5
CPUWeight=50
IOWeight=50
MemoryHigh=500M
MemoryMax=700M
MemorySwapMax=0
# Ядро убивает агента охотнее, чем gonba/Postgres/nginx.
OOMScoreAdjust=200

# --- G463: opencode распаковывает fff-библиотеку в /tmp (5.5 МБ за запуск). ---
# PrivateTmp отводит сервису собственный /tmp — общий /tmp бокса не растёт.
PrivateTmp=yes

# Агент не получает root: sudo/su внутри юнита не работают (прод-операции — руками владельца).
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
