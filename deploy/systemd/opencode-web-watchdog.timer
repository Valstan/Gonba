[Unit]
Description=OpenCode Web watchdog timer (юнит активен, а сервер молчит → restart)

[Timer]
# Через 3 минуты после загрузки бокса и дальше каждые 2 минуты после предыдущей проверки:
# три немые проверки подряд (~6 минут) — порог, за которым служба считается задохнувшейся.
# Две минуты — компромисс: чаще незачем (сервер стартует 10–20 с и в это окно молчит
# законно), реже — владелец успевает увидеть «ярлык не работает».
OnBootSec=3min
OnUnitInactiveSec=2min
Unit=opencode-web-watchdog.service

[Install]
WantedBy=timers.target
